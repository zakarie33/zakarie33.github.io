---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, getProjectBySlug } from '../../data/projects';
import { isConfigured } from '../../data/site';
import { withBase } from '../../utils/assets';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProjectBySlug(slug ?? '');

if (!project) {
  return Astro.redirect('/');
}

const title = project.title;
const description = project.shortDescription;
const showGithub = isConfigured(project.githubUrl);
const showDemo = isConfigured(project.liveDemoUrl);

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.shortDescription,
  ...(showGithub ? { codeRepository: project.githubUrl } : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  path={`/projects/${project.slug}`}
  jsonLd={projectJsonLd}
>
  <article class="section-pad pt-28">
    <div class="page-container max-w-4xl">
      <a
        href={`${import.meta.env.BASE_URL}#projects`}
        class="text-sm font-medium text-emerald-300 hover:text-emerald-200"
      >
        ← Back to projects
      </a>

      <header class="mt-6">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="heading-page font-bold text-[var(--text)]">{project.title}</h1>
          {project.status && (
            <span class="rounded-full bg-cyan-500/10 px-3 py-1 text-sm font-medium text-cyan-200">
              {project.status}
            </span>
          )}
        </div>
        {project.subtitle && (
          <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-cyan-300/90">{project.subtitle}</p>
        )}
        <p class="mt-4 text-lg leading-relaxed text-[var(--muted)]">{project.shortDescription}</p>
        {project.technologies.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <li class="rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-1 text-sm text-[var(--muted)]">
                {tech}
              </li>
            ))}
          </ul>
        )}
        <div class="mt-6 flex flex-wrap gap-3">
          {
            showGithub && (
              <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2 text-sm font-semibold text-[var(--text)] hover:border-emerald-400/40"
              >
                View repository
              </a>
            )
          }
          {
            showDemo && (
              <a
                href={project.liveDemoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400"
              >
                Live demo
              </a>
            )
          }
        </div>
      </header>

      <div class="mt-10 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface-elevated)]">
        {
          project.thumbnail ? (
            <img src={withBase(project.thumbnail)} alt="" class="aspect-video w-full object-cover" loading="eager" />
          ) : (
            <div class="flex aspect-video items-center justify-center bg-gradient-to-br from-emerald-500/10 via-transparent to-cyan-500/10 text-sm text-[var(--muted)]">
              Add a thumbnail path in src/data/projects.ts
            </div>
          )
        }
      </div>

      <div class="prose-section mt-12 space-y-10 text-[var(--muted)]">
        <section>
          <h2 class="text-xl font-semibold text-[var(--text)]">Overview</h2>
          <p class="mt-3 leading-relaxed">{project.detailedCaseStudy}</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-[var(--text)]">Problem</h2>
          <p class="mt-3 leading-relaxed">{project.problemStatement}</p>
        </section>
        <section>
          <h2 class="text-xl font-semibold text-[var(--text)]">Solution</h2>
          <p class="mt-3 leading-relaxed">{project.proposedSolution}</p>
        </section>
        {isConfigured(project.technicalChallenges) && (
          <section>
            <h2 class="text-xl font-semibold text-[var(--text)]">Technical challenges</h2>
            <p class="mt-3 leading-relaxed">{project.technicalChallenges}</p>
          </section>
        )}
        {project.keyFeatures.length > 0 && (
          <section>
            <h2 class="text-xl font-semibold text-[var(--text)]">Key features</h2>
            <ul class="mt-3 list-disc space-y-2 pl-5">
              {project.keyFeatures.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </section>
        )}
        {project.screenshots.length > 0 && (
          <section>
            <h2 class="text-xl font-semibold text-[var(--text)]">Screenshots</h2>
            <ul class="mt-4 grid gap-4 sm:grid-cols-2">
              {project.screenshots.map((shot, index) => (
                <li>
                  <img
                    src={withBase(shot)}
                    alt={`${project.title} screenshot ${index + 1}`}
                    loading="lazy"
                    class="rounded-xl border border-[var(--border)]"
                  />
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>