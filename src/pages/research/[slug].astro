---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResearchBySlug, researchEntries } from '../../data/research';
import { isConfigured } from '../../data/site';
import { withBase } from '../../utils/assets';

export function getStaticPaths() {
  return researchEntries.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;
const entry = getResearchBySlug(slug ?? '');

if (!entry) {
  return Astro.redirect('/');
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: entry.title,
  description: entry.abstract,
  ...(isConfigured(entry.doi) ? { sameAs: `https://doi.org/${entry.doi}` } : {}),
};
---

<BaseLayout title={entry.title} description={entry.abstract} path={`/research/${entry.slug}`} jsonLd={jsonLd}>
  <article class="section-pad pt-28">
    <div class="page-container max-w-3xl">
      <a href={`${import.meta.env.BASE_URL}#research`} class="text-sm font-medium text-emerald-300">← Back to research</a>
      <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-cyan-300/90">{entry.category}</p>
      <h1 class="heading-section mt-2 font-bold text-[var(--text)]">{entry.title}</h1>
      <p class="mt-2 text-sm text-[var(--muted)]">{entry.field}</p>

      <section class="prose-section mt-10 space-y-8 text-[var(--muted)]">
        <div>
          <h2 class="text-lg font-semibold text-[var(--text)]">Abstract</h2>
          <p class="mt-2 leading-relaxed">{entry.abstract}</p>
        </div>
        {entry.objectives.length > 0 && (
          <div>
            <h2 class="text-lg font-semibold text-[var(--text)]">Objectives</h2>
            <ul class="mt-2 list-disc space-y-1 pl-5">
              {entry.objectives.map((o) => <li>{o}</li>)}
            </ul>
          </div>
        )}
        {isConfigured(entry.methodology) && (
          <div>
            <h2 class="text-lg font-semibold text-[var(--text)]">Methodology</h2>
            <p class="mt-2">{entry.methodology}</p>
          </div>
        )}
        {isConfigured(entry.citation) && (
          <div>
            <h2 class="text-lg font-semibold text-[var(--text)]">Citation</h2>
            <p class="mt-2 font-mono text-sm">{entry.citation}</p>
          </div>
        )}
        {isConfigured(entry.pdfPath) && (
          <a
            href={withBase(entry.pdfPath)}
            class="inline-flex rounded-xl bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950"
            target="_blank"
            rel="noopener noreferrer"
          >
            Download PDF
          </a>
        )}
      </section>
    </div>
  </article>
</BaseLayout>