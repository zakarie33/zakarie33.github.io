---
interface Props {
  title: string;
  message: string;
  dataHint: string;
}

const { title, message, dataHint } = Astro.props;
---

<div data-reveal class="reveal mt-10 rounded-2xl border border-dashed border-[var(--border)] bg-[var(--surface)]/70 p-8 sm:p-10">
  <h3 class="text-lg font-semibold text-[var(--text)]">{title}</h3>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--muted)]">{message}</p>
  <p class="mt-4 text-xs text-[var(--muted)]">
    Edit <code class="text-emerald-300">{dataHint}</code> to add verified content.
  </p>
</div>