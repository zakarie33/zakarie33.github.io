---
import ThemeToggle from './ThemeToggle';
import { DesktopNav, MobileNavMenu } from './NavMenu';
import { person } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-xl transition-[box-shadow,border-color,background] duration-500">
  <div class="page-container safe-pad flex items-center justify-between gap-3 py-3 sm:gap-4 sm:py-4">
    <a href="#home" class="group flex items-center gap-3 rounded-xl outline-offset-4" aria-label={`${person.fullName} home`}>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-400 to-teal-500 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/20 transition group-hover:scale-[1.02]">
        {person.initials}
      </span>
      <span class="hidden text-sm font-semibold text-[var(--text)] sm:block">{person.brandName}</span>
    </a>

    <DesktopNav client:idle />

    <div class="flex items-center gap-2">
      <ThemeToggle client:idle />
      <MobileNavMenu client:idle />
    </div>
  </div>
</header>