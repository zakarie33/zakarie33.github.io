---
import CopyEmail from './CopyEmail';
import { person, isConfigured } from '../data/site';
import { withBase } from '../utils/assets';

const showResume = isConfigured(person.resumePath);
const phoneHref = `tel:${person.phone.replace(/\s/g, '')}`;
---

<section id="contact" class="section-pad border-t border-[var(--border)] bg-[var(--surface)]/40">
  <div class="page-container">
    <div data-reveal class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-300/90">Contact</p>
      <h2 class="heading-section mt-3 font-bold text-[var(--text)]">Work with me</h2>
      <p class="mt-4 text-[var(--muted)]">
        {person.fullName} — available for software engineering collaborations and professional opportunities.
      </p>
      {person.availableForOpportunities && (
        <p class="mt-3 inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-3 py-1 text-sm font-medium text-emerald-200">
          <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          Available for opportunities
        </p>
      )}
    </div>

    <div data-reveal class="reveal mt-10 grid gap-8 lg:grid-cols-2">
      <div class="min-w-0 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-4 sm:p-6 md:p-8">
        <h3 class="text-sm font-semibold uppercase tracking-wide text-[var(--text)]">Contact details</h3>
        <dl class="mt-6 space-y-4 text-sm">
          <div>
            <dt class="text-[var(--muted)]">Name</dt>
            <dd class="mt-1 font-medium text-[var(--text)]">{person.fullName}</dd>
          </div>
          <div>
            <dt class="text-[var(--muted)]">Email</dt>
            <dd class="mt-1">
              <a href={`mailto:${person.email}`} class="font-medium text-emerald-300 hover:text-emerald-200">
                {person.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-[var(--muted)]">Phone</dt>
            <dd class="mt-1">
              <a href={phoneHref} class="font-medium text-emerald-300 hover:text-emerald-200">
                {person.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-[var(--muted)]">Location</dt>
            <dd class="mt-1 font-medium text-[var(--text)]">{person.location}</dd>
          </div>
        </dl>
      </div>

      <div class="flex w-full min-w-0 flex-col gap-3">
        <a
          href={`mailto:${person.email}`}
          class="touch-target inline-flex w-full justify-center rounded-xl bg-emerald-500 px-5 py-3.5 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400"
        >
          Send Email
        </a>
        <a
          href={phoneHref}
          class="touch-target inline-flex w-full justify-center rounded-xl border border-[var(--border)] bg-[var(--surface)] px-5 py-3.5 text-sm font-semibold text-[var(--text)] transition hover:border-emerald-400/40"
        >
          Call Me
        </a>
        <a
          href={person.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target inline-flex w-full justify-center rounded-xl border border-[var(--border)] bg-[var(--surface)] px-5 py-3.5 text-sm font-semibold text-[var(--text)] transition hover:border-emerald-400/40"
        >
          GitHub
        </a>
        <a
          href={person.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="touch-target inline-flex w-full justify-center rounded-xl border border-[var(--border)] bg-[var(--surface)] px-5 py-3.5 text-sm font-semibold text-[var(--text)] transition hover:border-emerald-400/40"
        >
          LinkedIn
        </a>
        <CopyEmail client:visible email={person.email} />
        {
          showResume && (
            <a
              href={withBase(person.resumePath)}
              class="touch-target inline-flex w-full justify-center rounded-xl border border-emerald-400/35 bg-emerald-500/10 px-5 py-3.5 text-sm font-semibold text-emerald-200 transition hover:bg-emerald-500/20"
              download
            >
              Download CV
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>