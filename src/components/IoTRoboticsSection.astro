---
import { hasHardwarePortfolio, hardwareProjects } from '../data/iot-robotics';
import SectionHeader from './SectionHeader.astro';
import PortfolioEmptyState from './PortfolioEmptyState.astro';
---

<section id="iot-robotics" class="section-pad border-t border-[var(--border)]">
  <div class="page-container">
    <SectionHeader
      eyebrow="IoT & Robotics"
      title="Connected devices & intelligent systems"
      description="Hardware prototypes, sensor integration, robotics software, and system architecture — engineering-oriented layouts for verified projects."
    />

    {
      hasHardwarePortfolio() ? (
        <ul class="mt-10 grid gap-6 md:grid-cols-2">
          {hardwareProjects.map((project) => (
            <li data-reveal class="reveal rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-cyan-300/90">{project.domain}</p>
              <h3 class="mt-1 text-lg font-semibold text-[var(--text)]">{project.title}</h3>
              <p class="mt-3 text-sm text-[var(--muted)]">{project.summary}</p>
              {project.status && (
                <p class="mt-2 text-xs text-emerald-300/90">Status: {project.status}</p>
              )}
              <a
                href={`${import.meta.env.BASE_URL}hardware/${project.slug}`}
                class="mt-4 inline-flex text-sm font-semibold text-emerald-300 hover:text-emerald-200"
              >
                View technical details
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <PortfolioEmptyState
          title="IoT & robotics portfolio ready"
          message="Add verified hardware, embedded, and robotics projects with images, diagrams, specs, and demonstration links when available."
          dataHint="src/data/iot-robotics.ts"
        />
      )
    }
  </div>
</section>