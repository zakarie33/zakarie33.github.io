---
import { person, getSocialLinks } from '../data/site';

const year = new Date().getFullYear();
const socials = getSocialLinks();
---

<footer class="border-t border-[var(--border)] bg-[var(--surface)]/60">
  <div class="page-container py-10 sm:py-12">
    <div class="grid gap-8 md:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="text-lg font-semibold text-[var(--text)]">{person.fullName}</p>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-[var(--muted)]">
          {person.heroHeadline}. Based in {person.location}.
        </p>
      </div>
      <div>
        <p class="text-sm font-semibold text-[var(--text)]">Connect</p>
        <ul class="mt-3 flex flex-wrap gap-3">
          {socials.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[var(--muted)] transition hover:text-emerald-300"
                target={link.id === 'email' || link.id === 'phone' ? undefined : '_blank'}
                rel={link.id === 'email' || link.id === 'phone' ? undefined : 'noopener noreferrer'}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <a href="#home" class="mt-6 inline-flex text-sm font-medium text-emerald-300 hover:text-emerald-200">
          Back to top
        </a>
      </div>
    </div>
    <p class="mt-10 border-t border-[var(--border)] pt-6 text-center text-xs text-[var(--muted)]">
      © {year} {person.fullName}. All rights reserved.
    </p>
  </div>
</footer>