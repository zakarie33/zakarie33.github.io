---
import { skillCategories } from '../data/skills';

const categoryIcons: Record<string, string> = {
  layout:
    '<path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  server:
    '<rect x="3" y="4" width="18" height="6" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  smartphone:
    '<rect x="7" y="2" width="10" height="20" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 18h2" stroke="currentColor" stroke-width="1.5"/>',
  database:
    '<ellipse cx="12" cy="6" rx="8" ry="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  wrench:
    '<path d="M14 6a4 4 0 0 0-5.5 5.5L3 17l4 4 5.5-5.5A4 4 0 0 0 14 6Z" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  shield:
    '<path d="M12 3 4 6v6c0 4.5 3.5 7.7 8 9 4.5-1.3 8-4.5 8-9V6l-8-3Z" fill="none" stroke="currentColor" stroke-width="1.5"/>',
};

---

<section id="skills" class="section-pad border-t border-[var(--border)] bg-[var(--surface)]/40">
  <div class="page-container">
    <div data-reveal class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-300/90">Technical Skills</p>
      <h2 class="mt-3 text-3xl font-bold text-[var(--text)] sm:text-4xl">Stack & tooling</h2>
      <p class="mt-4 text-[var(--muted)]">
        Technologies I use across web, mobile, backend, and IT — editable in <code>src/data/skills.ts</code>.
      </p>
    </div>

    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {skillCategories.map((category, index) => (
        <li
          data-reveal
          class="reveal rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 transition hover:border-emerald-400/25 hover:shadow-[0_16px_40px_-24px_rgba(16,185,129,0.45)]"
          style={`transition-delay: ${Math.min(index * 40, 200)}ms`}
        >
          <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-300">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" set:html={categoryIcons[category.icon]} />
            </span>
            <h3 class="text-base font-semibold text-[var(--text)]">{category.title}</h3>
          </div>
          <ul class="mt-4 flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <li class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] px-2.5 py-1 text-xs font-medium text-[var(--muted)]">
                <span class="h-1.5 w-1.5 rounded-full bg-cyan-400/80" aria-hidden="true"></span>
                {skill}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>