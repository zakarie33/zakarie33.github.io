---
import { person } from '../data/site';
import { fetchGithubRepos } from '../utils/github';
import type { GithubRepoCard } from '../data/github';

const repos: GithubRepoCard[] = await fetchGithubRepos();
---

<section id="github" class="section-pad border-t border-[var(--border)]" aria-labelledby="github-heading">
  <div class="page-container">
    <div data-reveal class="reveal max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-300/90">GitHub</p>
      <h2 id="github-heading" class="heading-section mt-3 font-bold text-[var(--text)]">GitHub activity</h2>
      <p class="mt-4 text-[var(--muted)]">
        Public repositories from{' '}
        <a
          href={person.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-emerald-300 hover:text-emerald-200"
        >
          @{person.githubUsername}
        </a>
        {repos.length === 0
          ? ' — repositories load at build time when available, or add cards in src/data/github.ts.'
          : '.'}
      </p>
    </div>

    {
      repos.length > 0 ? (
        <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
          {repos.map((repo) => (
            <li data-reveal class="reveal">
              <a
                href={repo.htmlUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex h-full flex-col rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 transition hover:border-emerald-400/30 hover:shadow-[0_16px_40px_-24px_rgba(16,185,129,0.4)]"
              >
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-semibold text-[var(--text)] group-hover:text-emerald-200">{repo.name}</h3>
                  {typeof repo.stars === 'number' && (
                    <span class="shrink-0 rounded-lg border border-[var(--border)] bg-[var(--surface-elevated)] px-2 py-0.5 text-xs text-[var(--muted)]" title="GitHub stars">
                      ★ {repo.stars}
                    </span>
                  )}
                </div>
                {repo.description && (
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--muted)]">{repo.description}</p>
                )}
                {repo.language && (
                  <p class="mt-4 text-xs font-medium text-cyan-300/90">{repo.language}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div data-reveal class="reveal mt-10 rounded-2xl border border-dashed border-[var(--border)] bg-[var(--surface)]/60 p-8 text-sm text-[var(--muted)]">
          Add curated repositories in <code>githubRepoFallback</code> inside <code>src/data/github.ts</code>, or
          optionally set <code>GITHUB_TOKEN</code> during CI builds for higher GitHub API limits.
        </div>
      )
    }

    <div class="mt-8">
      <a
        href={person.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-xl border border-[var(--border)] bg-[var(--surface)] px-5 py-3 text-sm font-semibold text-[var(--text)] transition hover:border-emerald-400/40"
      >
        View GitHub profile
      </a>
    </div>
  </div>
</section>